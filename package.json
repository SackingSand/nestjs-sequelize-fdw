    "tsx": "^4.22.0",
    "typescript": "^6.0.3",
    "sequelize": "^6.37.8",
    "sequelize-typescript": "^2.1.6"
  },
  "peerDependencies": {
    "sequelize": "^6.37.8",
    "sequelize-typescript": "^2.1.6"
  }
}
