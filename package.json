{
  "name": "sequelize-fdw",
  "version": "1.1.2",
  "description": "Plug and Play sequelize model for Postgresql Foreign Data Wrapper (FDW)",
  "keywords": [
    "sequelize",
    "postgresql",
    "fdw"
  ],
  "license": "ISC",
  "author": "sackingsand",
  "contributors": [
    "Ikhraaazh <ikhsanrafi06@gmail.com> (https://github.com/Ikhraaazh)"
  ],
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/sackingsand/sequelize-fdw.git"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
